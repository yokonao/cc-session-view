{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/*.md"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noArrayForEach": "error",
				"noAsyncPromiseFinally": "error",
				"noConfusingArraySplice": "error",
				"noDuplicateTypeConstituents": "error",
				"noInvalidFetchOptions": "error",
				"noMisusedSpread": "error",
				"noNewArray": "error",
				"noRedundantTypeConstituents": "error",
				"noSyncMethods": "error",
				"noUnresolvedDefaultImport": "error",
				"noUselessAwait": "error",
				"noUselessFallbackInSpread": "error",
				"noUselessSpread": "error",
				"noUselessTypeAssertion": "error",
				"useAtomicUpdates": "error",
				"useCatchErrorName": "error",
				"useGlobalRegexInMatchAll": "error",
				"useGlobalRegexInReplaceAll": "error",
				"useValidCharacterComparison": "error",
				"useValidNamespaceImports": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "web/index.tsx"],
			"linter": { "rules": { "nursery": { "noSyncMethods": "off" } } }
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
