{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/*.md"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noArrayForEach": "error",
				"noSyncMethods": "error",
				"noUselessAwait": "error",
				"noUselessTypeAssertion": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "web/index.tsx"],
			"linter": { "rules": { "nursery": { "noSyncMethods": "off" } } }
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
